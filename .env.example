KOTAE_ENV=local
KOTAE_ALLOW_INSECURE_DEV=true
PORT=8080

# Required outside local development.
GOOGLE_CLOUD_PROJECT=REPLACE_WITH_DEDICATED_KOTAE_PROJECT_ID
GOOGLE_CLOUD_LOCATION=global
KOTAE_ALLOWED_APP_IDS=REPLACE_WITH_FIREBASE_WEB_APP_ID

KOTAE_FAST_MODEL=vertexai/gemini-3.6-flash
KOTAE_PRECISION_MODEL=vertexai/gemini-3.1-pro-preview
# Opt-in only: Priority PayGo keeps the same models and raises token pricing.
KOTAE_VERTEX_PRIORITY=false
KOTAE_SPEECH_LOCATION=asia-northeast1
KOTAE_SPEECH_MODEL=chirp_3
KOTAE_SPEECH_VOICE=ja-JP-Chirp3-HD-Kore
# Generate once with a cryptographically secure RNG. Production must inject
# this value from Secret Manager; never commit the real key.
KOTAE_STATE_KEY_BASE64=REPLACE_WITH_32_BYTE_STANDARD_BASE64
KOTAE_REQUEST_TIMEOUT=25s
KOTAE_VOICE_TIMEOUT=50s
KOTAE_MAX_REQUEST_BYTES=32768
KOTAE_MAX_VOICE_BYTES=13631488
KOTAE_VOICE_RATE_LIMIT_PER_MINUTE=12
KOTAE_VOICE_RATE_LIMIT_PER_DAY=120
KOTAE_VOICE_APP_RATE_LIMIT_PER_MINUTE=20
KOTAE_VOICE_APP_RATE_LIMIT_PER_DAY=200
