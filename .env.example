KOTAE_ENV=local
KOTAE_ALLOW_INSECURE_DEV=true
PORT=8080

# Required outside local development.
GOOGLE_CLOUD_PROJECT=REPLACE_WITH_DEDICATED_KOTAE_PROJECT_ID
GOOGLE_CLOUD_LOCATION=global
KOTAE_ALLOWED_APP_IDS=REPLACE_WITH_FIREBASE_WEB_APP_ID

KOTAE_FAST_MODEL=vertexai/gemini-3.6-flash
KOTAE_PRECISION_MODEL=vertexai/gemini-3.1-pro-preview
# Opt-in only: Priority PayGo keeps the same models and raises token pricing.
KOTAE_VERTEX_PRIORITY=false
# Additive encrypted-state prerequisites. Roll these out reader-first.
KOTAE_STATE_V2_WRITES=false
KOTAE_COACH_RESTATEMENT_BINDING=false
KOTAE_ANSWER_PROOF_WRITES=false
# Reader-first rollout gate for the finite, text-free verifier-progress audit posterior.
KOTAE_VERIFIER_PROGRESS_WRITES=false
# Behavior canary. Enable only after every serving revision can read that audit posterior.
KOTAE_RETRIEVAL_POLICY_ENABLED=false
KOTAE_SPEECH_LOCATION=asia-northeast1
# Audited continuous-conversation model; change only after a project canary and coordinated allowlist update.
KOTAE_SPEECH_MODEL=chirp_3
KOTAE_SPEECH_VOICE=ja-JP-Chirp3-HD-Kore
# Standard live conversation can opt into the GA native-audio fast lane.
# Strict mode, PDF turns, and buffered HTTP fallback never use this route.
KOTAE_NATIVE_AUDIO_ENABLED=false
# Independent rollout/rollback gate for donating final Native captions to the
# audited staged path. It is valid only after Native Audio, verifier-progress
# writes, and the retrieval policy are all enabled.
KOTAE_NATIVE_CAPTION_HANDOFF_ENABLED=false
KOTAE_NATIVE_AUDIO_LOCATION=us-central1
KOTAE_NATIVE_AUDIO_MODEL=gemini-live-2.5-flash-native-audio
KOTAE_NATIVE_AUDIO_VOICE=Kore
# Generate once with a cryptographically secure RNG. Production must inject
# this value from Secret Manager; never commit the real key.
KOTAE_STATE_KEY_BASE64=REPLACE_WITH_32_BYTE_STANDARD_BASE64
KOTAE_REQUEST_TIMEOUT=25s
KOTAE_VOICE_TIMEOUT=50s
KOTAE_MAX_REQUEST_BYTES=32768
KOTAE_MAX_VOICE_BYTES=13631488
KOTAE_VOICE_RATE_LIMIT_PER_MINUTE=12
KOTAE_VOICE_RATE_LIMIT_PER_DAY=120
KOTAE_VOICE_APP_RATE_LIMIT_PER_MINUTE=20
KOTAE_VOICE_APP_RATE_LIMIT_PER_DAY=200

# Passkey ceremonies are exact-origin WebAuthn operations. Keep the voice gate
# false for the first backend/frontend rollout; set true only after a real
# registration and reauthentication canary succeeds on the public origin.
KOTAE_PASSKEY_RP_ID=kotae-ai.web.app
KOTAE_PASSKEY_ORIGIN=https://kotae-ai.web.app
# Per-client ceremony quota and a separate application-wide safety ceiling.
KOTAE_PASSKEY_CLIENT_RATE_LIMIT_PER_MINUTE=10
KOTAE_PASSKEY_CLIENT_RATE_LIMIT_PER_DAY=100
KOTAE_PASSKEY_APP_CIRCUIT_BREAKER_PER_MINUTE=300
KOTAE_PASSKEY_APP_CIRCUIT_BREAKER_PER_DAY=20000
# Production defaults to true even when omitted. Set false only for explicit local development.
KOTAE_REQUIRE_RECENT_PASSKEY_FOR_VOICE=true
