KOTAE_ENV=local
KOTAE_ALLOW_INSECURE_DEV=true
PORT=8080

# Required outside local development.
GOOGLE_CLOUD_PROJECT=REPLACE_WITH_DEDICATED_KOTAE_PROJECT_ID
GOOGLE_CLOUD_LOCATION=global
KOTAE_ALLOWED_APP_IDS=REPLACE_WITH_FIREBASE_WEB_APP_ID

KOTAE_FAST_MODEL=vertexai/gemini-2.5-flash
KOTAE_REQUEST_TIMEOUT=25s
KOTAE_MAX_REQUEST_BYTES=32768
